# Public API origin used by browser requests.
#
# Keep this empty during local development. Requests to /api/* will be
# forwarded by the Vite development proxy to Vix.cpp.
#
# Production example:
# PUBLIC_API_BASE_URL=https://api.orelunza.com
PUBLIC_API_BASE_URL=

# Private development-only target used by vite.config.ts.
# This variable is never exposed to browser code.
VIX_API_PROXY_TARGET=http://127.0.0.1:8080
